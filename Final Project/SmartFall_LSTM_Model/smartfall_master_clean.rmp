      <operator activated="true" class="blending:generate_columns" compatibility="12.1.001" expanded="true" height="82" name="Generate Attributes" width="90" x="715" y="34">
        <list key="function_descriptions">
          <parameter key="lstm_correct" value="if(actual_label==predicted_label,1,0)"/>
          <parameter key="deviation_score" value="round((1 - probability_stable)*10000)/10000"/>
          <parameter key="confidence" value="round(max(probability_gradual_drift, probability_stable, probability_sudden_change, probability_temporary_change)*10000)/10000"/>
          <parameter key="high_flag" value="if(deviation_score &gt;= 0.5,1,0)"/>
        </list>
        <parameter key="keep_all_columns" value="true"/>
        <parameter key="default_time_zone" value="Asia/Calcutta"/>
