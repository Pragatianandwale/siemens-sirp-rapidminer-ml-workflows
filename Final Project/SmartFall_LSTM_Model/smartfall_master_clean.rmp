      <operator activated="true" class="blending:generate_columns" compatibility="12.1.001" expanded="true" height="82" name="Generate Attributes (4)" width="90" x="1184" y="238">
        <list key="function_descriptions">
          <parameter key="days_since_prev_seq" value="if(missing(prev_day),0,sequence_end_day-prev_day)"/>
          <parameter key="dev_trend" value="if(missing(dev_lag1),0,round((deviation_score-dev_lag1)*10000)/10000)"/>
          <parameter key="dev_roll3" value="round(if(missing(dev_lag2),if(missing(dev_lag1),deviation_score,(deviation_score+dev_lag1)/2),(deviation_score+dev_lag1+dev_lag2)/3)*10000)/10000"/>
          <parameter key="consec_high" value="if(high_flag==0,0,if(missing(hi_lag1) || hi_lag1==0,1,if(missing(hi_lag2) || hi_lag2==0,2,3)))"/>
          <parameter key="persistent_deviation" value="if(consec_high&gt;=2,1,0)"/>
        </list>
        <parameter key="keep_all_columns" value="true"/>
        <parameter key="default_time_zone" value="Asia/Calcutta"/>
      </operator>
